# Non-secret reference for the selected gateway-managed profile, NOT an installer.
# Source analyzed: OmniRoute 3.8.53; installed/validated version is still unverified.
# Dashboard required: do not start with --headless.
OMNIROUTE_SERVER_HOST=127.0.0.1
OMNIROUTE_HEADLESS=0
REQUIRE_API_KEY=true
# Do not blanket-disable background services: review optional subsystems individually
# and retain required OAuth refresh, quota handling and backup scheduling.
# This file does NOT disable cloud sync, memory, tunnels, MCP/A2A or other features.
# BEFORE introducing accounts, supply STORAGE_ENCRYPTION_KEY through a private
# secret store outside this repo and verify effective credential encryption.
# Protect dashboard/management separately; REQUIRE_API_KEY is inference policy.
# Supply OMNIROUTE_API_KEY to the Pi CLIENT separately (not the storage key).
# No credentials belong in this file or this repository.
