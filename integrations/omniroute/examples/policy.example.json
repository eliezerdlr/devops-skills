{
  "version": 1,
  "allowMetered": false,
  "maxInputUsdPerMillion": 3,
  "maxOutputUsdPerMillion": 15,
  "maxAttempts": 2,
  "deadlineMs": 60000,
  "attemptTimeoutMs": 25000,
  "contextWindow": 32000,
  "maxOutputTokens": 4096,
  "maxInputBytes": 26000,
  "routes": [
    {
      "provider": "openai-codex",
      "model": "REPLACE_WITH_PI_SUBSCRIPTION_MODEL_ID",
      "origin": "https://chatgpt.com",
      "billing": "subscription",
      "supportsTools": true
    },
    {
      "provider": "omniroute",
      "model": "REPLACE_WITH_APPROVED_EXPLICIT_GATEWAY_MODEL_ID",
      "origin": "http://127.0.0.1:20128",
      "billing": "metered",
      "supportsTools": true,
      "gatewayPolicyApproved": false
    }
  ]
}
